# Copy this file to `.env` and fill in real values.

# Postgres (docker-compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_DB=idea_factory
DATABASE_URL=postgres://postgres:changeme@localhost:5433/idea_factory

# LLM API
ROUTERAI_API_KEY=

# STT (optional, uses routerai.ru)
# TAVILY_API_KEY=

# Sentry (optional)
SENTRY_DSN=

# App
APP_ENV=production
