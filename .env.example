# Copy this file to `.env` and fill in real values.

# Postgres (docker-compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_DB=idea_factory
DATABASE_URL=postgres://postgres:changeme@localhost:5433/idea_factory

# LLM-провайдер (серверная часть; значения — только в .env, никогда в git)
# LLM_API_KEY приоритетный; ROUTERAI_API_KEY читается как имя-наследник (Dokploy, тесты).
# База и модель — из config/llm.ts; прошлый провайдер отдавал 401 на генерацию,
# и из-за зашитых констант это лечилось только переписыванием кода.
LLM_API_KEY=
LLM_BASE_URL=https://api.b.ai/v1
LLM_MODEL=qwen3.8-flash
ROUTERAI_API_KEY=

# STT (optional, использует routerai.ru — тот же ключ, что и раньше)
# TAVILY_API_KEY=

# LangSmith (LLM observability)
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=idea-factory

# App
APP_ENV=production
