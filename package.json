{
  "name": "idea-factory",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare && prisma skills sync",
    "db:migrate": "prisma db update",
    "db:down": "prisma db execute --stdin <<< \"SELECT 1\"",
    "db:status": "prisma db execute --stdin <<< \"SELECT 1\"",
    "db:new": "prisma migration dev --create-only",
    "worker": "tsx server/queue/worker-cli.ts",
    "typecheck": "nuxt typecheck",
    "test": "vitest run",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepare": "husky",
    "contract:emit": "prisma contract emit",
    "contract:infer": "prisma contract infer",
    "db:sign": "prisma db sign",
    "db:update": "prisma db update"
  },
  "lint-staged": {
    "*.{ts,vue,mjs}": [
      "eslint --fix --max-warnings 0"
    ]
  },
  "dependencies": {
    "@langchain/langgraph": "^1.4.14",
    "@langchain/langgraph-checkpoint-postgres": "^1.0.5",
    "@lucide/vue": "^1.42.0",
    "@nuxt/icon": "^2.5.1",
    "@prisma/composer": "^0.17.0",
    "@prisma/orm-postgres": "8.0.0-rc.8",
    "@sentry/nuxt": "^10.73.0",
    "@vueuse/core": "^14.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "evlog": "^2.28.1",
    "lucide-vue-next": "^1.0.0",
    "nuxt": "^4.5.2",
    "pg": "^8.23.0",
    "prisma": "8.0.0-rc.13",
    "reka-ui": "^2.10.4",
    "tailwind-merge": "^3.6.0",
    "temporal-polyfill": "^1.0.4",
    "tw-animate-css": "^1.4.0",
    "vue": "^3.5.42",
    "vue-router": "^5.3.0",
    "vue-sonner": "^2.0.9",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint-community/eslint-plugin-eslint-comments": "^4.7.2",
    "@nuxt/a11y": "1.0.0-alpha.1",
    "@nuxt/eslint": "^1.17.0",
    "@playwright/cli": "^0.1.19",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/pg": "^8.23.1",
    "@vitest/eslint-plugin": "^1.6.27",
    "eslint": "^10.10.0",
    "eslint-plugin-ai-guard": "^1.3.0",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-no-secrets": "^2.3.3",
    "eslint-plugin-perfectionist": "^5.11.0",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-regexp": "^3.3.0",
    "eslint-plugin-security": "^4.0.1",
    "eslint-plugin-slop": "^0.1.3",
    "eslint-plugin-sonarjs": "^4.2.0",
    "eslint-plugin-unicorn": "^74.0.0",
    "eslint-plugin-vuejs-accessibility": "^2.6.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.0",
    "shadcn-vue": "^2.8.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript-eslint": "^8.69.0",
    "vitest": "^3.2.7",
    "vue-tsc": "^3.3.11"
  }
}
